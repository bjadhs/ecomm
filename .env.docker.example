# Copy this to `.env` on the server (next to docker-compose.yml) and fill it in.
# docker compose reads it automatically for ${VAR} substitution.
# This file is the ONLY place credentials live — never commit the real `.env`.

# Public hostname. Traefik routes this to the container and requests the cert.
# Point a DNS A record at the VPS before the first deploy.
APP_HOST=ecom.bijbrin.cloud

# --- Build-time (baked into the JS bundle; rebuild after any change) ---------
VITE_CLERK_PUBLISHABLE_KEY=
# Leave as /api so the SPA calls its own origin — this is what keeps the Clerk
# session cookie flowing without an Authorization header.
VITE_API_URL=/api
# Comma-separated. MUST match ADMIN_EMAIL below or the admin UI and the API
# will disagree about who is an admin.
VITE_ADMIN_EMAILS=

# --- Runtime ----------------------------------------------------------------
# Existing Atlas cluster. Remember to whitelist the VPS IP in Atlas Network Access.
MONGODB_URI=

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# From the Inngest dashboard; also re-point the Inngest app URL to
# https://$APP_HOST/api/inngest or Clerk user sync will silently stop.
INNGEST_SIGNING_KEY=

# Comma-separated admin allowlist enforced by the API (authMiddleware.js).
ADMIN_EMAIL=
